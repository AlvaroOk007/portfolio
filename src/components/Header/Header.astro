---
import "./Header.css";
import navBar from "../../constants/nav-bar-items.json";
import Image from "astro/components/Image.astro";
import miLogo from "../../assets/logo-dark.png";
import ButtonLanguaje from "./ui/ButtonLanguaje.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/index";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="header-container">
  <div class="header__logo-container">
    <Image src={miLogo} alt="Logo" />
  </div>
  <nav class="nav-bar-container">
    <ul class="nav-bar__list-container">
      {
        navBar.items.map((item) => (
          <a href={`#${item}`} class={`${item === "skills" ? "active" : ""}`}>
            <li class="nav-bar__item" data-i18n={`nav.${[item]}`}>
              {t(`nav.${[item]}`)}
            </li>
          </a>
        ))
      }
    </ul>
  </nav>
  <div class="btn-rigth-container">
    <ButtonLanguaje />
    <span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        ><path
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 21a9 9 0 0 0 8.997-9.252a7 7 0 0 1-10.371-8.643A9 9 0 0 0 12 21"
          stroke-width="2"></path></svg
      >
    </span>
  </div>
  <div class="btn-hamburger" id="btn-hamburguesa">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="23"
      height="23"
      viewBox="0 0 24 24"
      ><path fill="currentColor" d="M3 4h18v2H3zm0 7h18v2H3zm0 7h18v2H3z"
      ></path></svg
    >
  </div>
  <script src="../../scripts/hamburguesa.js"></script>
</header>
